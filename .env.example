# Copy to .env.local for local development. Values here are public once built:
# the purpose of keeping them out of the repo is git history and search engines, not viewers.

# Kakao Developers > App > App Keys > JavaScript key (map + KakaoTalk share). Leave empty to use fallbacks.
VITE_KAKAO_JS_KEY=

# Deployed site URL without trailing slash (used for share links and OG tags).
VITE_SITE_URL=

# Base path for assets: '/' (custom domain, Vercel) or '/Mobile-Wedding-Invitation-KR/' (GitHub project page).
VITE_BASE=/

# Private contact and account data as JSON. When empty, src/lib/private.ts falls back to sample values.
# VITE_CONTACTS='{"groom":"010-0000-0000","bride":"010-0000-0000","groomFather":"","groomMother":"","brideFather":"","brideMother":""}'
# VITE_ACCOUNTS='{"groom":[{"holder":"이OO","bank":"OO은행","number":"000-0000-0000"}],"bride":[{"holder":"박OO","bank":"OO은행","number":"000-0000-0000"}]}'
VITE_CONTACTS=
VITE_ACCOUNTS=

# Google Apps Script Web App URL for guestbook + RSVP (see google-apps-script/Code.gs).
# Empty = preview mode: entries are kept in the browser's localStorage only.
VITE_APPS_SCRIPT_URL=
